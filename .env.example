# Copy this to .env and fill in the blanks: `cp .env.example .env`.
# Never commit a real .env — see .gitignore.
#
# The values below are the ones the docker-compose.yml stack needs, because
# that is the documented way to run this locally (see docs/DEPLOYMENT.md).
# The hostnames are Docker service names, NOT localhost: docker-compose.yml
# passes this file straight through to the corefront and admin containers
# with `env_file: .env` and overrides nothing, so `localhost` inside a
# container would mean the container itself. If you ever run the PHP outside
# Docker, point DB_HOST/REDIS_HOST/SMTP_HOST at wherever those services
# actually listen.
#
# Only the blank values need filling in. Everything already set is a working
# local default.

# --- Source repo (docker/*/Dockerfile build-time git clone) ---
# GITHUB_TOKEN needs at least read access to secondcaesar-apps/petra-corporate-ibank.
# For local verification this can be a personal token (e.g. `gh auth token`);
# a real deployment should use a scoped deploy token instead, not a personal one.
GITHUB_TOKEN= 
# Branch, tag or commit the image build clones. Pin this to a release tag for
# a real deploy.
GIT_REF=main
# Docker's layer cache has no way to know GIT_REF's branch got new commits
# pushed — without a value here that changes on every real rebuild, it
# silently keeps reusing the OLD clone. Set this to the target branch's
# current commit SHA before building, e.g.:
#   CACHEBUST=$(git rev-parse main) docker compose build
CACHEBUST=

# --- Database (class.dbConnect.php) ---
# DB_HOST is the compose service name. DB_PASSWORD is also what the db
# service initialises MariaDB's root password to, so pick any value before
# the first `docker compose up` — after that it is baked into the volume and
# changing it here alone will lock you out until you re-create the volume.
DB_HOST=db
DB_PORT=3306
DB_NAME=dbPetra
DB_USER=root
DB_PASSWORD=

# --- BankOne core-banking API (class.BankOne.php) ---
# Live credential issued by BankOne for this institution. Treat it as a
# production secret: it is not needed to bring the local stack up, and the
# local seed customer is not a real BankOne customer, so BankOne-backed
# actions will return nothing in local testing either way.
BANKONE_API_KEY=
BANKONE_INST_ID=

# --- Outbound mail (class.Mailer.php, vendored PHPMailer) ---
# Defaults target the mailpit container in docker-compose.yml, which accepts
# unauthenticated plaintext SMTP on 1025 and shows what was "sent" at
# http://localhost:18025. For a real mailbox: the host, port 465, SMTP_SECURE=ssl
# and SMTP_AUTH=1 with real credentials.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# 'ssl' (implicit TLS, matches port 465), 'tls' (STARTTLS, typically port 587),
# or empty for plaintext — only ever appropriate for a local test SMTP server.
SMTP_SECURE=
# '1' to authenticate (a real mailbox needs this) or '0' to skip auth entirely
# (only for a local test SMTP server with no AUTH).
SMTP_AUTH=0

# --- Request/response encryption (class.Secure.php) ---
# No variable here on purpose. There is no static/shared key —
# class.Secure.php starts with empty keys and every session gets its own,
# minted at OTP validation (User::validateOTP()) and stored in Redis (see
# REDIS_* below).
# Pre-session traffic (login, validateOTP itself, forgot_password) is plain
# JSON over TLS.

# --- Session store (class.User.php: redis()/startSession()/getSession()) ---
# Holds session:<token> -> {UserID, CryptoKey, CryptoIV} and a
# user:active:<UserID> pointer used to evict a user's previous session on a
# new login (single session per user). Requires the PECL `redis` extension.
# If Redis is unreachable, session lookups fail closed (treated as no
# session, same as an invalid/expired one) rather than crash the request.
# REDIS_HOST is the compose service name; the local redis has no password.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Session lifetime in seconds; refreshed on every authenticated request.
SESSION_TTL=3600
